COOKIE_SECURE=1
STORAGE_BACKEND=supabase
SUPABASE_URL=https://kopvvjbsrvwuteplmphp.supabase.co
SUPABASE_STORAGE_BUCKET=product-images
# Copy the exact transaction-pooler URI from Supabase Connect (port 6543).
# Insert the password securely and URL-encode special characters.
