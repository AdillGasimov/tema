# Copy to a private environment file; do not commit credentials or runtime data.
# Load with your process manager. The app does not automatically read .env files.
PUBLIC_BASE_URL=https://mikrofiber.shop
DATA_DIR=/var/lib/mikrofiber
COOKIE_SECURE=1
WHATSAPP_NUMBER=994994350013
DELIVERY_FEE_AZN=3.99
# Only when bound to loopback behind exactly one trusted reverse proxy:
TRUST_PROXY=1
# Admin credentials are created interactively, never shipped in frontend code:
# .venv/bin/python -m mikrofiber create-admin --username owner
